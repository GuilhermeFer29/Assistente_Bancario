# =================================================================
# Streamlit Frontend — imagem self-contained
# =================================================================
FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    PORT=8501

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system app && adduser --system --ingroup app app

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY frontend /app/frontend

RUN chown -R app:app /app

USER app

EXPOSE 8501

HEALTHCHECK --interval=20s --timeout=5s --retries=5 --start-period=15s \
    CMD curl -fsS http://localhost:${PORT}/_stcore/health || exit 1

CMD ["sh", "-c", "streamlit run frontend/streamlit_app.py --server.port=${PORT} --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false"]
