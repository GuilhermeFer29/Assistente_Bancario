# ╔═══════════════════════════════════════════════════════════════╗
# ║  Assistente Bancário V2 — variáveis de ambiente                ║
# ║  Copie para .env e preencha. Tudo (Docker e local) lê daqui.   ║
# ╚═══════════════════════════════════════════════════════════════╝

# ─── LLM (obrigatórias para os agentes) ────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
TAVILY_API_KEY=

# ─── Segurança bot ↔ gateway ───────────────────────────────────
# Token compartilhado entre bot_service e banking_gateway nas rotas internas
# (criação de Step-Up, OTP, transações). Em prod: gere um valor aleatório forte.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=dev-internal-token-please-change

# ─── App ────────────────────────────────────────────────────────
AMBIENTE=dev          # dev | staging | prod
DEBUG=false           # em true, OTP/email vão para o log
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
STREAM_ENABLED=false

# ─── Rede Docker ───────────────────────────────────────────────
# DNS usado pelos containers que precisam de internet (Gemini, Tavily, SMTP externo).
# Necessário em hosts com systemd-resolved ou redes corporativas.
DOCKER_DNS_PRIMARY=8.8.8.8
DOCKER_DNS_SECONDARY=1.1.1.1

# ─── Portas (host:container) ───────────────────────────────────
GATEWAY_PORT=8001
BOT_PORT=8000
STREAMLIT_PORT=8501
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500

# ─── Transporte bot → gateway ──────────────────────────────────
# in_process: bot importa o gateway diretamente (1 processo)
# http:       bot fala HTTP com o gateway (compose default)
GATEWAY_TRANSPORT=in_process
GATEWAY_TRANSPORT_DOCKER=http      # usado dentro do compose
GATEWAY_URL=http://localhost:8001  # local (host) — compose sobrescreve para http://gateway:8001

# URL pública do gateway, vista pelo browser do usuário (para os links de Step-Up)
GATEWAY_PUBLIC_URL=http://localhost:8001
GATEWAY_PUBLIC_URL_HOST=http://localhost:8001

# WS do bot, visto pelo Streamlit (local). No compose é sobrescrito para ws://bot:8000/chat/ws
BOT_WS_URL=ws://localhost:8000/chat/ws

# ─── E-mail ────────────────────────────────────────────────────
# Mailpit (dev): sem auth, sem TLS, porta 1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bancoagil.local
SMTP_TLS=false           # TLS implícito (porta 465)
SMTP_STARTTLS=false      # STARTTLS (porta 587, ex: Gmail/Outlook)
#
# Para usar Gmail real, troque para:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu.email@gmail.com
#   SMTP_PASSWORD=sua-app-password    # crie em myaccount.google.com/apppasswords
#   SMTP_FROM=Banco Ágil <seu.email@gmail.com>
#   SMTP_STARTTLS=true

# ─── Banco de dados ────────────────────────────────────────────
BOT_DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
AGNO_DB_FILE=./data/bot.db

# ─── Segurança / Tempos ────────────────────────────────────────
OTP_EXPIRACAO_MIN=5
OTP_MAX_TENTATIVAS=3
OTP_BLOQUEIO_MIN=15
CONFIRMACAO_EXPIRACAO_MIN=10
CONFIRMACAO_MAX_TENTATIVAS=3
